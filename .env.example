# Public site
NEXT_PUBLIC_SITE_URL=https://thecodedoctors.com

# Plausible analytics (self-hosted - configure in Phase 1 deploy)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=thecodedoctors.com
NEXT_PUBLIC_PLAUSIBLE_HOST=

# Cloudflare Turnstile (forms / diagnostic tool)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (transactional email)
RESEND_API_KEY=

# Database — Postgres on Neon (free tier works)
# Get yours at neon.tech — copy the "Pooled connection" URL.
DATABASE_URL=

# Auth.js
# Generate AUTH_SECRET with: openssl rand -base64 32  (or `npx auth secret`)
AUTH_SECRET=
AUTH_URL=https://app.thecodedoctors.com

# Google PageSpeed Insights API (free up to 25k/day)
# Used by /api/checkup performance scoring. Optional — heuristics still run without it.
PSI_API_KEY=

# Uptime cron — Bearer token gate for /api/cron/uptime.
# Generate with: openssl rand -hex 32
# Then point a scheduler (Cloudflare Cron Triggers or cron-job.org) at
#   POST https://thecodedoctors.com/api/cron/uptime
#   Authorization: Bearer <this value>
# Cadence: every 5 minutes is a sensible v1 default.
CRON_SECRET=

# Stripe (Phase 4+)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe Price IDs — create in dashboard.stripe.com → Products
# Each Price points at a Product; the same Product can have multiple
# Prices (e.g. one monthly recurring, one yearly recurring). Yearly
# prices should be set to the discounted total ($299 × 12 × 0.85 etc.).
#   General Care:  $299/mo  /  $3,049/yr
#   Premium Care:  $999/mo  /  $10,189/yr
#   The Checkup:   $599 one-time (Product type = one-time, not recurring)
STRIPE_PRICE_GENERAL=
STRIPE_PRICE_GENERAL_YEARLY=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_CHECKUP=

# Cloudflare R2 (Phase 3+)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Pusher (Phase 3+)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Sentry
# NEXT_PUBLIC_SENTRY_DSN is the PUBLIC project DSN — used by the
# lightweight Workers-safe capture in src/lib/sentry.ts (client +
# server error boundaries). Set it on the Cloudflare Worker to turn
# error reporting on; unset = silent no-op. (SENTRY_DSN /
# SENTRY_AUTH_TOKEN below are only needed if/when the full SDK is added.)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
