# Public site
NEXT_PUBLIC_SITE_URL=https://thecodedoctors.com

# Plausible analytics (self-hosted - configure in Phase 1 deploy)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=thecodedoctors.com
NEXT_PUBLIC_PLAUSIBLE_HOST=

# Cloudflare Turnstile (forms / diagnostic tool)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (transactional email)
RESEND_API_KEY=

# Database — Postgres on Neon (free tier works)
# Get yours at neon.tech — copy the "Pooled connection" URL.
DATABASE_URL=

# Auth.js
# Generate AUTH_SECRET with: openssl rand -base64 32  (or `npx auth secret`)
AUTH_SECRET=
AUTH_URL=https://app.thecodedoctors.com

# Google PageSpeed Insights API (free up to 25k/day)
# Used by /api/checkup performance scoring. Optional — heuristics still run without it.
PSI_API_KEY=

# Stripe (Phase 4+)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Cloudflare R2 (Phase 3+)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Pusher (Phase 3+)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Sentry
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
